# Copiar a .streamlit/secrets.toml (en tu compu) o pegar en Streamlit Cloud:
# Settings > Secrets. .streamlit/secrets.toml está en .gitignore y NUNCA va al
# repo.
#
# Es la cuenta de la Business Intelligence API de Reporting and Analytics
# (Administration > System > API Accounts). Su contraseña vence cada 60 días.

[oracle_bi]
auth_server = "https://YOUR-AUTHENTICATION-SERVER"
application_server = "https://YOUR-APPLICATION-SERVER"
org_identifier = "YOUR_ENTERPRISE_SHORT_NAME"
client_id = "YOUR_BUSINESS_INTELLIGENCE_API_CLIENT_ID"
username = "YOUR_BUSINESS_INTELLIGENCE_API_ACCOUNT"
password = "YOUR_BI_PASSWORD"
application_name = "Broken Yolk Payroll"
timeout_seconds = 45
verify_ssl = true
